# PostgreSQL (Supabase) — external, async driver
# Accepts standard postgresql:// or postgres:// URIs
SUPABASE_POSTGRES_URL=postgresql://user:password@host:5432/postgres

# MongoDB — local docker container (see docker-compose.yml)
mongo_url=mongodb://localhost:27017
mongo_db_name=polyglot_catalog

# Redis — local docker container (see docker-compose.yml)
redis_url=redis://localhost:6379/0

# App
app_env=development
app_host=0.0.0.0
app_port=8000
